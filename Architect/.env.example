# Runtime
OMEGA_ENV=production
OMEGA_LOG_LEVEL=INFO
OMEGA_TIMEZONE=UTC
OMEGA_HITL_LEVEL=5

# Google GenAI SDK
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro

# Qdrant Vector Cloud
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_CLUSTER_ID=YOUR_QDRANT_CLUSTER_ID
QDRANT_URL=YOUR_QDRANT_URL
QDRANT_USE_LOCAL_FALLBACK=true

# Kraken Pro Execution & Staking
KRAKEN_API_KEY=YOUR_KRAKEN_API_KEY
KRAKEN_API_SECRET=YOUR_KRAKEN_API_SECRET
KRAKEN_FUTURES_KEY=YOUR_KRAKEN_FUTURES_KEY
KRAKEN_FUTURES_SECRET=YOUR_KRAKEN_FUTURES_SECRET
KRAKEN_ENABLE_FIX=true
KRAKEN_STAKING_AUTO_COMPOUND=true

# Intelligence Feeds
BYBIT_API_KEY=YOUR_BYBIT_API_KEY
BYBIT_API_SECRET=YOUR_BYBIT_API_SECRET
ALPHAVANTAGE_API_KEY=YOUR_ALPHAVANTAGE_API_KEY
GAINIUM_API_KEY=YOUR_GAINIUM_API_KEY
GAINIUM_WEBHOOK_SECRET=YOUR_GAINIUM_WEBHOOK_SECRET

# Risk Invariants (§14)
MAX_TOTAL_LEVERAGE=5.0
MAX_SLIPPAGE_BPS=15.0
MIN_VAULT_RESERVE_RATIO=0.10
MAX_POSITION_RISK_PCT=0.02
VIA_NEGATIVA_QUANTILE=0.999
CLUSTER_SCAN_INTERVAL_SECONDS=300
FEED_STALE_TIMEOUT_SECONDS=15.0
NETRON_PORT=8082
