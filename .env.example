# -------------------------------------------------------------
# Google Gemini API
# -------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------
# LM Studio (Local OpenAI-Compatible Server)
# Default LM Studio server URL is http://localhost:1234/v1
# -------------------------------------------------------------
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# -------------------------------------------------------------
# OneProvider Universal Gateway (https://api.oneprovider.dev)
# 3rd Option (Standby / Inactive until explicitly activated)
# -------------------------------------------------------------
ONEPROVIDER_KEY=
ONEPROVIDER_BASE_URL=https://api.oneprovider.dev
ONEPROVIDER_MODEL=claude-sonnet-4-6

# -------------------------------------------------------------
# Vercel Connect connector uids (not secrets).
# Leave empty to keep the API-key fallbacks above.
# Create one from this directory (browser consent required):
#   npx vercel connect create github --name nin
# -------------------------------------------------------------
CONNECT_GEMINI=
CONNECT_ONEPROVIDER=
CONNECT_GITHUB=

# -------------------------------------------------------------
# Kraken CLI. Leave empty to use ./bin/kraken or a `kraken` binary on PATH.
# The API key pair stays a Vercel env var. Connect issues bearer tokens,
# not HMAC secrets.
# -------------------------------------------------------------
KRAKEN_CLI_PATH=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
