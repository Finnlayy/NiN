# -------------------------------------------------------------
# Google Gemini API
# -------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------
# LM Studio (Local OpenAI-Compatible Server)
# Default LM Studio server URL is http://localhost:1234/v1
# -------------------------------------------------------------
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# -------------------------------------------------------------
# OneProvider Universal Gateway (https://api.oneprovider.dev)
# 3rd Option (Standby / Inactive until explicitly activated)
# -------------------------------------------------------------
ONEPROVIDER_KEY=
ONEPROVIDER_BASE_URL=https://api.oneprovider.dev
ONEPROVIDER_MODEL=claude-sonnet-4-6

# -------------------------------------------------------------
# Qdrant — Knowledge Base collection `knowledge_library`
# Leave QDRANT_URL empty to keep knowledge entries in
# data/learning/store.json only.
# -------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_KNOWLEDGE_COLLECTION=knowledge_library
