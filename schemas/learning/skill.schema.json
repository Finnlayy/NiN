{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-orchestrator.local/schemas/learning/skill.schema.json",
  "title": "Skill",
  "description": "A learned capability with statistical proficiency, spaced-repetition schedule and error memory.",
  "type": "object",
  "required": [
    "id", "name", "domain", "proficiency", "confidence", "trials", "successes", "errors",
    "intervalDays", "easeFactor", "errorFingerprints", "antiPatterns", "knowledgeIds",
    "createdAt", "updatedAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "domain": { "type": "string", "enum": ["ml_30core", "dev_dp", "generic", "unknown", "misc"] },
    "algorithmTag": { "type": "string" },
    "proficiency": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "trials": { "type": "integer", "minimum": 0 },
    "successes": { "type": "integer", "minimum": 0 },
    "errors": { "type": "integer", "minimum": 0 },
    "lastOutcomeAt": { "type": "string", "format": "date-time" },
    "nextReviewAt": { "type": "string", "format": "date-time" },
    "intervalDays": { "type": "number", "minimum": 1 },
    "easeFactor": { "type": "number", "minimum": 1.3 },
    "errorFingerprints": { "type": "array", "items": { "type": "string" } },
    "antiPatterns": { "type": "array", "items": { "type": "string" } },
    "knowledgeIds": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
