{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-orchestrator.local/schemas/learning/learning_task.schema.json",
  "title": "LearningTask",
  "description": "A unit of scheduled learning work generated by the learning algorithm from outcomes, feedback and Knowledge Base changes.",
  "type": "object",
  "required": [
    "id", "type", "title", "description", "subject", "priority", "status",
    "requirements", "progress", "createdAt", "updatedAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["remediation", "practice", "research", "kb_upgrade", "evaluation", "calibration", "schema_revision"]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "subject": { "type": "string" },
    "relatedTaskSignature": {
      "type": "object",
      "properties": {
        "taskDescriptionHash": { "type": "string" },
        "tokens": { "type": "array", "items": { "type": "string" } },
        "domain": { "type": "string" },
        "algorithmTag": { "type": ["string", "null"] }
      }
    },
    "targetSkillId": { "type": "string" },
    "priority": { "type": "number", "minimum": 0, "maximum": 1 },
    "effortHours": { "type": "number", "minimum": 0 },
    "status": { "type": "string", "enum": ["pending", "scheduled", "in_progress", "done", "cancelled"] },
    "schedule": {
      "type": "object",
      "required": ["dueAt", "createdAt", "intervalMs", "windowMs"],
      "properties": {
        "dueAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "intervalMs": { "type": "number", "minimum": 0 },
        "windowMs": { "type": "number", "minimum": 0 }
      }
    },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "results": {
      "type": "object",
      "properties": {
        "outcomeId": { "type": "string" },
        "knowledgeEntryIds": { "type": "array", "items": { "type": "string" } },
        "improvedSkillId": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
